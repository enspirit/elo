      input: {weightKg: 77, heightCm: 175},
      expect: {bmi: 25.1, category: 'overweight'}
    },
    {
      name: 'heavy',
      input: {weightKg: 95, heightCm: 175},
      expect: {bmi: 31, category: 'obese'}
    },
    {
      name: 'short',
      input: {weightKg: 60, heightCm: 155},
      expect: {bmi: 25, category: 'overweight'}
    },
    {
      name: 'tall',
      input: {weightKg: 90, heightCm: 200},
      expect: {bmi: 22.5, category: 'normal'}
    }
  ]
}
