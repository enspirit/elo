    },
    {
      name: 'heavy domestic parcel',
      input: {weightKg: 8, lengthCm: 30, widthCm: 20, heightCm: 20, zone: 'domestic', express: false, orderValue: 40},
      expect: {billableWeight: 8, volumetric: 2.4, freeShipping: false, cost: 9.75, etaDays: 2}
    },
    {
      name: 'light but bulky, billed by volume',
