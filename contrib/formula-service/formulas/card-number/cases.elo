      input: {number: '4539578763621487'},
      expect: {valid: false, brand: 'Visa', masked: '************1487'}
    },
    {
      name: 'two digits transposed',
      input: {number: '4539578763624186'},
      expect: {valid: false, brand: 'Visa', masked: '************4186'}
    },
    {
