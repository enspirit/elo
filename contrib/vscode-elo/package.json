{
  "name": "vscode-elo",
  "displayName": "Elo",
  "description": "Syntax highlighting for the Elo expression language",
  "version": "0.1.0",
  "publisher": "enspirit",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "elo",
    "expression language",
    "syntax highlighting",
    "textmate"
  ],
  "homepage": "https://elo-lang.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enspirit/elo.git",
    "directory": "contrib/vscode-elo"
  },
  "bugs": {
    "url": "https://github.com/enspirit/elo/issues"
  },
  "contributes": {
    "languages": [
      {
        "id": "elo",
        "aliases": [
          "Elo",
          "elo"
        ],
        "extensions": [
          ".elo"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/elo-light.png",
          "dark": "./icons/elo-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "elo",
        "scopeName": "source.elo",
        "path": "./syntaxes/elo.tmLanguage.json"
      }
    ]
  },
  "files": [
    "LICENSE",
    "README.md",
    "icon.png",
    "icon.svg",
    "icons/",
    "language-configuration.json",
    "syntaxes/"
  ],
  "scripts": {
    "test": "node test/tokenize.test.mjs",
    "icons": "magick -background none -density 384 icon.svg -resize 128x128 PNG32:icon.png && magick -background none -density 384 icons/elo-dark.svg -resize 64x64 PNG32:icons/elo-dark.png && magick -background none -density 384 icons/elo-light.svg -resize 64x64 PNG32:icons/elo-light.png",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  }
}
