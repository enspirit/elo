    },
    {
      name: 'two digits swapped',
      input: {iban: 'BE68539007540734'},
      expect: {valid: false, country: 'BE', formatted: 'BE68 5390 0754 0734'}
    },
    {
      name: 'too short',
      input: {iban: 'BE6853900754'},
      expect: {valid: false, country: null, formatted: null}
    },
    {
      name: 'country is not letters',
