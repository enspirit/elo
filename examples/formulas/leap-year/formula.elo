# Is a year a leap year?
#
# The Gregorian rule, which is the one every calendar library gets asked for:
# a year divisible by 4 is a leap year, except a century, except a century
# divisible by 400.

let
  isLeapYear = fn( input ~>
    let y = input.year
    in (y % 4 == 0 && y % 100 != 0) || y % 400 == 0
  )
in
  { formula: isLeapYear }
