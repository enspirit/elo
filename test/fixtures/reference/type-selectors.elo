assert(Int(123) == 123)
assert(Int('123') == 123)
assert(Int('-42') == -42)
assertFails(fn( ~> Int('abc') ))
# A leading zero is a zero, not a base: a zero-padded numeric string is what an
# identifier, a form field or a CSV column hands over.
assert(Int('08') == 8)
assert(Int('09') == 9)
assert(Int('010') == 10)
assert(Int('007') == 7)
assert(Int('-08') == -8)
assert(Int('01234567') == 1234567)
# A number followed by anything else is not a number
assertFails(fn( ~> Int('12abc') ))
assertFails(fn( ~> Int('1.5') ))
assert(Float(3.14) == 3.14)
assert(Float('3.14') == 3.14)
assert(Float('-2.5') == -2.5)
assert(Float('123') == 123.0)
assert(Float('08.5') == 8.5)
assert(Float('1e3') == 1000.0)
assert(Float('.5') == 0.5)
assert(Float('1.') == 1.0)
assertFails(fn( ~> Float('abc') ))
assertFails(fn( ~> Float('2.5abc') ))
assert(Bool(true) == true)
assert(Bool(false) == false)
assert(Bool('true') == true)
assert(Bool('false') == false)
assertFails(fn( ~> Bool('yes') ))
assert(Date(D2025-01-15) == D2025-01-15)
assert(Date('2025-01-15') == D2025-01-15)
assertFails(fn( ~> Date('not-a-date') ))
assert(Datetime(D2025-01-15T10:30:00) == D2025-01-15T10:30:00)
assert(Datetime('2025-01-15T10:30:00') == D2025-01-15T10:30:00)
assertFails(fn( ~> Datetime('not-a-datetime') ))
assert(Duration(P1D) == P1D)
assert(Duration('P1D') == P1D)
assert(Duration('PT2H30M') == PT2H30M)
assertFails(fn( ~> Duration('not-a-duration') ))
assert(String('hello') == 'hello')
assert(String(123) == '123')
assert(String(3.14) == '3.14')
assert(String(true) == 'true')
assert(String(false) == 'false')
assert(String([1, 2, 3]) == '[1, 2, 3]')
assert(String({name: 'Alice'}) == '{name: \'Alice\'}')

# String(x) where nothing knows x's type must still *convert*, not inspect.
# `min([x])` is typed `any`, so these take the dynamic path on all four targets
# while staying literals the runner can evaluate without an input.
assert(String(min(['hello'])) == 'hello')
assert(String(min([''])) == '')
assert(String(min([123])) == '123')
