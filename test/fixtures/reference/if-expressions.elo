assert((if true then 1 else 2) == 1)
assert((if 5 > 3 then 'yes' else 'no') == 'yes')
assert((if 1 > 2 then 'a' else if 2 > 1 then 'b' else 'c') == 'b')
assert((if 10 > 5 then 100 + 1 else 200 - 1) == 101)
assert((let x = 10 in if x > 5 then 'big' else 'small') == 'big')
assert((if true then let x = 1 in x + 1 else let y = 2 in y + 2) == 2)
assert((if true and true then 1 else 0) == 1)
assert(if true then true else false)
assert(if 5 > 3 then 10 == 10 else false)

# An if expression is an expression, so it is also an operand. Both branches
# have to stay inside it: a target emitting a conditional operator has to
# delimit it, or the operator around it swallows the condition.
assert(1 + (if true then 10 else 20) == 11)
assert(1 + (if false then 10 else 20) == 21)
assert((if true then 10 else 20) + 1 == 11)
assert((if false then 10 else 20) + 1 == 21)
assert(2 * (if false then 3 else 4) == 8)
assert((if false then 3 else 4) * 2 == 8)
assert(10 - (if false then 3 else 4) == 6)
assert(12 / (if false then 3 else 4) == 3)
assert('a' + (if false then 'b' else 'c') == 'ac')
assert(-(if false then 3 else 4) == -4)
assert(!(if false then true else false))
assert((if false then 1 else 2) == 2 && (if true then 1 else 2) == 1)
assert((if false then 1 else 2) + (if true then 10 else 20) == 12)
assert(round((if false then 1.26 else 2.34), 1) == 2.3)
