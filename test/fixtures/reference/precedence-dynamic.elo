# Operator precedence when operand types are not statically known.
#
# Lambda parameters are typed `any`, so the stdlib dispatch falls back to the
# native operator. Parenthesisation must follow that fallback: a target that
# emits `a + b` natively but reports the call as "not a native binary op"
# drops the parentheses and silently changes the result.

assert((let f = fn( x, y ~> 12 * (x + y) ) in f(1, 2)) == 36)
assert((let f = fn( x, y ~> (x + y) * 12 ) in f(1, 2)) == 36)
assert((let f = fn( x, y ~> 12 - (x + y) ) in f(1, 2)) == 9)
assert((let f = fn( x, y ~> 12 / (x + y) ) in f(1, 2)) == 4)
assert((let f = fn( x, y ~> 12 % (x + y) ) in f(5, 2)) == 5)
assert((let f = fn( x, y ~> (x + y) ^ 2 ) in f(1, 2)) == 9)
assert((let f = fn( x, y ~> -(x + y) ) in f(40, 15)) == -55)
assert((let f = fn( x, y ~> 2 * (x - y) ) in f(5, 1)) == 8)
assert((let f = fn( x, y ~> 100 / (x * y) ) in f(2, 5)) == 10)
assert((let f = fn( x, y, z ~> x * (y + z) - 1 ) in f(2, 3, 4)) == 13)
assert((let f = fn( x, y ~> (x + 1) * (y + 1) ) in f(2, 3)) == 12)
assert((let f = fn( x, y ~> 1 - (x - y) ) in f(5, 2)) == -2)
assert((let f = fn( x, y ~> 24 / (x / y) ) in f(6, 2)) == 8)

# The same shapes must keep working when the types ARE known statically.
assert(12 * (1 + 2) == 36)
assert(12 - (1 + 2) == 9)
assert(-(40 + 15) == -55)
assert(24 / (6 / 2) == 8)

# Comparison and logical operators with dynamic operands.
assert((let f = fn( x, y ~> (x + y) > 10 ) in f(6, 5)) == true)
assert((let f = fn( x, y ~> (x > y) == true ) in f(2, 1)) == true)
assert((let f = fn( x, y ~> !(x > y) ) in f(1, 2)) == true)

# An if expression as an operand, where the operand types are not known either.
assert((let f = fn( x ~> x + (if true then 10 else 20) ) in f(1)) == 11)
assert((let f = fn( x ~> x + (if false then 10 else 20) ) in f(1)) == 21)
assert((let f = fn( x ~> (if false then 10 else 20) + x ) in f(1)) == 21)
assert((let f = fn( x ~> x * (if false then 3 else 4) ) in f(2)) == 8)
assert((let f = fn( x ~> -(if false then x else x + 1) ) in f(3)) == -4)

# A string function whose receiver is an expression, and whose other argument
# has no statically known type. The receiver has to keep its parentheses in
# that dispatch too: it is the same emission, reached through a different
# signature. See stdlib/string/concatenated-receiver.elo for the typed cases.
assert((let a = 'ab' in map(['abc'], fn( x ~> startsWith(a + 'cd', x) ))) == [true])
assert((let a = 'ab' in map(['bcd'], fn( x ~> endsWith(a + 'cd', x) ))) == [true])
assert((let a = 'ab' in map(['bc'], fn( x ~> contains(a + 'cd', x) ))) == [true])
assert((let a = 'ab' in map(['z'], fn( x ~> contains(a + 'cd', x) ))) == [false])
assert((let a = 'ab' in map(['c'], fn( x ~> indexOf(a + 'cd', x) ))) == [2])
assert((let a = 'ab' in map(['e'], fn( x ~> concat(a + 'cd', x) ))) == ['abcde'])
assert((let a = 'ab' in map([1], fn( x ~> substring(a + 'cd', x, 2) ))) == ['bc'])
assert((let a = 'ab' in map([1], fn( x ~> slice(a + 'cd', x, 3) ))) == ['bc'])
assert((let a = 'ab' in map(['c'], fn( x ~> replace(a + 'cd', x, 'Z') ))) == ['abZd'])
assert((let a = 'ab' in map(['c'], fn( x ~> replaceAll(a + 'cdc', x, 'Z') ))) == ['abZdZ'])
assert((let a = 'ab' in map(['0'], fn( x ~> padStart(a + 'cd', 6, x) ))) == ['00abcd'])
assert((let a = 'ab' in map([','], fn( x ~> split(a + ',cd', x) ))) == [['ab', 'cd']])
assert((let a = [1] in map([2], fn( x ~> contains(a + [3], x) ))) == [false])
assert((let a = [1] in map([3], fn( x ~> contains(a + [3], x) ))) == [true])
