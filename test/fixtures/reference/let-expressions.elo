assert((let x = 12 in x) == 12)
assert((let x = 12, y = 13 in x + y) == 25)
assert((let x = 5, y = 3 in x + y) == 8)
assert((let x = 2, y = 3 in x * y) == 6)
assert((let a = 10 in let b = 20 in a + b) == 30)
assert((let a = 5, b = a * 2 in b) == 10)
assert((let x = 2, y = x + 1, z = y + 1 in z) == 4)
assert((let x = 1 in let x = 2 in x) == 2)
assert((let x = 10 in x + (let x = 5 in x)) == 15)
# A binding that shadows another reads it in its own value, and leaves it alone
assert((let x = 1 in let x = x + 1 in x) == 2)
assert((let x = 10 in (let x = 5 in x) + x) == 15)
assert((let x = 1 in let x = x * 2, y = x in y) == 2)
assert((let x = 1 in (let x = x + 1 in x) + x) == 3)
assert((let a = (let a = 1 in a) + 1 in a) == 2)
