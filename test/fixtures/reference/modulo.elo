# `%` is floored in Elo: the result takes the sign of the *divisor*.
#
# The four targets were split two–two. Ruby and Python floor, which is what
# `%` means in an expression language aimed at non-programmers and what keeps
# `x % n` inside `[0, n)` for a positive `n`. JavaScript and PostgreSQL
# truncate, taking the sign of the dividend, as C does — so `-7 % 3` answered
# -1 there and 2 here.
#
# Nothing in the corpus covered it: every `%` assertion used non-negative
# operands, where the two conventions agree.

# Where the conventions agree
assert(7 % 3 == 1)
assert(9 % 3 == 0)
assert(0 % 5 == 0)
assert(1 % 5 == 1)

# A negative dividend: floored keeps the result in [0, divisor)
assert(-7 % 3 == 2)
assert(-1 % 3 == 2)
assert(-3 % 3 == 0)
assert(-9 % 5 == 1)

# A negative divisor: the result takes its sign
assert(7 % -3 == -2)
assert(1 % -3 == -2)
assert(-7 % -3 == -1)
assert(-9 % -5 == -4)

# Floats follow the same rule
assert(7.5 % 2 == 1.5)
assert(-7.5 % 2 == 0.5)
assert(7.5 % -2 == -0.5)

# What it is for: a cycle that stays in range however far back you count
assert(-1 % 7 == 6)
assert(-8 % 7 == 6)
assert((0 - 15) % 7 == 6)

# And it composes
assert((7 % 3) + 10 == 11)
assert(-7 % 3 * 2 == 4)
assert((let n = -7 in n % 3) == 2)
