assert(typeOf(fn( ~> 42 )) == 'Function')
assert(typeOf(fn( ~> 2 * 3 )) == 'Function')
assert(typeOf(fn( x ~> x )) == 'Function')
assert(typeOf(fn( x ~> x * 2 )) == 'Function')
assert(typeOf(fn( x, y ~> x + y )) == 'Function')
assert(typeOf(fn( a, b, c ~> a + b + c )) == 'Function')
assert(typeOf(fn( x ~> x * x + 1 )) == 'Function')
assert(typeOf(fn( price ~> price * 1.21 )) == 'Function')
assert(typeOf(fn( _ ~> _.budget * 1.21 )) == 'Function')
assert(typeOf(fn( item ~> item.price + item.tax )) == 'Function')
assert(typeOf(fn( x ~> let doubled = x * 2 in doubled + 1 )) == 'Function')
assert(typeOf(fn( x ~> if x > 0 then x else 0 - x )) == 'Function')
assert((let double = fn( x ~> x * 2 ) in double(5)) == 10)
assert((let add = fn( x, y ~> x + y ) in add(3, 4)) == 7)
assert((let double = fn( x ~> x * 2 ) in double(2)) == 4)
# A parameter may carry a name an outer binding already uses: one name per scope
assert((let a = 1, f = fn( a ~> a * 2 ) in f(5) + a) == 11)
assert((let a = 1 in fn( a ~> fn( b ~> a + b ) )(10)(5)) == 15)
# A lambda bound to a shadowing name calls the one it shadows, not itself
assert((let f = fn( x ~> x + 1 ) in let f = fn( x ~> f(x) * 2 ) in f(1)) == 4)
assert((let g = fn( x ~> let x = x + 1 in x ) in g(1)) == 2)
assert((let f = fn( x ~> let f = fn( y ~> y * 3 ) in f(x) ) in f(2)) == 6)
assert((let x = fn( q ~> let x = q + 1 in x ) in x(1) + x(2)) == 5)
# A function stored in data is applied through a field read, or through a name bound to one
assert({ f: fn( x ~> x * 2 ) }.f(4) == 8)
assert((let fs = { f: fn( x ~> x * 2 ) } in let f = fs.f in f(4)) == 8)
assert((let fs = { f: fn( x, y ~> x - y ) } in let f = fs.f in f(3, 1)) == 2)
