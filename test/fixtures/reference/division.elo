# `/` is real division in Elo, in every target.
#
# Ruby and PostgreSQL both truncate Integer / Integer, so both bindings have to
# opt out of the native operator when the operands are statically integers:
# Ruby emits `fdiv`, SQL casts to double precision. The lambda cases, where the
# types are only known at runtime, are in division-dynamic.elo — SQL has no
# lambdas, and no way to divide two unknown operands as reals either.

assert(7 / 2 == 3.5)
assert(1 / 4 == 0.25)
assert(10 / 4 == 2.5)
assert(1 / 3 > 0.33)
assert(3 / 2 * 2 == 3)
assert(100 / 8 == 12.5)
assert(-7 / 2 == -3.5)
assert(0 / 5 == 0)

# Mixed and float operands keep working
assert(7.0 / 2 == 3.5)
assert(7 / 2.0 == 3.5)
assert(7.5 / 2.5 == 3)

# Through a let binding, where the type comes from the binding's value
assert((let n = 2 in 7 / n) == 3.5)
assert((let a = 10, b = 4 in a / b) == 2.5)

# Division still composes with the rest of the arithmetic
assert((1 + 1) / 4 == 0.5)
assert(24 / (6 / 2) == 8)
assert(round(7 / 2) == 4)
