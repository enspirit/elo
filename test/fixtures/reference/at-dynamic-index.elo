# at() where the index is a runtime value rather than a literal.
#
# The typed at([Int], Int) emitter used to spell a bare `x[k]` on JavaScript,
# on the reasoning that the checker knew the index was an Int. A declared type
# is a promise, not a runtime check: under --optimize with --input-type, `_.i`
# compiles to a bare read of whatever actually arrived, so an index of
# 'constructor' walked the prototype chain to the Function constructor. Fixed
# in 1.2.3 by routing every non-literal index through kAt.
#
# Nothing in the corpus indexed a list with anything but a literal, so neither
# the acceptance suite nor the emitted-grammar gate could reach the emitter
# that held the escape. Every line here makes the index a runtime value.
#
# SQL has no lambdas, so the dynamic half cannot be expressed there; the typed
# half with a runtime index lives in stdlib/list/access/at.elo, which SQL does
# cover.

# Typed: the checker knows the index is an Int, but it is not a literal
assert((let i = 1 in at([10, 20, 30], i)) == 20)
assert((let i = 2 in at(['a', 'b', 'c'], i)) == 'c')
assert((let i = 1 in at([10, 20, 30], i + 1)) == 30)
assert((let i = 99 in isNull(at([10, 20, 30], i))) == true)

# Dynamic: a lambda parameter is typed `any`, so both operands reach the
# dynamic dispatch path, which is a separate body of emitted code
assert((let f = fn( xs, i ~> at(xs, i) ) in f([10, 20, 30], 2)) == 30)
assert((let f = fn( xs, i ~> at(xs, i) ) in f(['a', 'b'], 0)) == 'a')
assert((let f = fn( xs, i ~> isNull(at(xs, i)) ) in f([10, 20], 99)) == true)
assert((let f = fn( i ~> at([10, 20, 30], i) ) in f(1)) == 20)

# A negative index is null, not a read from the end, on both paths
assert((let f = fn( xs, i ~> isNull(at(xs, i)) ) in f([10, 20], -1)) == true)
assert((let i = -1 in isNull(at([10, 20], i))) == true)
