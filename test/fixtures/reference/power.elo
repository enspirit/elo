# `^` with a negative exponent.
#
# Ruby's `**` answers a **Rational** for an Integer base and a negative Integer
# exponent: `2 ** -1` is `(1/2)`, not `0.5`. It compares equal to 0.5, so no
# assertion on the value could catch it — but `typeOf` could, and did: it said
# 'Tuple', because the type dispatcher has no case for a Rational and fell
# through to the last one. A Rational leaking into the rest of an expression is
# the same surprise `Date - Date` produced before 0175.

assert(2 ^ 10 == 1024)
assert(2 ^ 1 == 2)
assert(2 ^ 0 == 1)
assert(9 ^ 0.5 == 3)

assert(2 ^ -1 == 0.5)
assert(2 ^ -2 == 0.25)
assert(4 ^ -1 == 0.25)
assert(10 ^ -3 == 0.001)

# The type, which is where the Rational showed
assert(typeOf(2 ^ -1) == 'Float')
assert(typeOf(2 ^ -2) == 'Float')
assert(isNull(2 ^ -1) == false)

# And it composes, rather than carrying a Rational along
assert(2 ^ -1 + 0.5 == 1)
assert(2 ^ -1 * 4 == 2)
assert((let e = -1 in 2 ^ e) == 0.5)

# Anything that dispatches on Int versus Float. `pow(Int, Int)` is declared
# `Float`, because Elo cannot know the exponent's sign statically and `2 ^ -1`
# is not an Int. Declared `Int`, these picked the Int implementations — and
# `round`, `floor` and `ceil` on an Int are the identity, so they did nothing
# at all.
assert(round(2 ^ -1) == 1)
assert(round(2 ^ -2) == 0)
assert(floor(2 ^ -1) == 0)
assert(ceil(2 ^ -1) == 1)
assert(floor(2 ^ 10) == 1024)
assert(round(2 ^ 10) == 1024)

# Division of a power, which is where a declared Float that is secretly an
# integer at runtime would truncate
assert(2 ^ 3 / 2 == 4)
assert(2 ^ 3 / 16 == 0.5)
assert(5 ^ 1 / 2 == 2.5)
