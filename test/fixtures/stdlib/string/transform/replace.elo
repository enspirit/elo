assert(replace('hello world', 'world', 'there') == 'hello there')
assert(replace('abab', 'ab', 'x') == 'xab')
assert(replaceAll('abab', 'ab', 'x') == 'xx')
assert(replace('a.b.c', '.', 'X') == 'aXb.c')
assert(replaceAll('a.b.c', '.', 'X') == 'aXbXc')
assert(replace('1+1', '+', '-') == '1-1')
assert(replaceAll('a(b)c', '(', '[') == 'a[b)c')
