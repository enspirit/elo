assert(extract('From: John <john@acme.com>', 'From: {{name}} <{{email}}>').name == 'John')
assert(extract('From: John <john@acme.com>', 'From: {{name}} <{{email}}>').email == 'john@acme.com')
assert(extract('Name: Alice', 'Name: {{name}}').name == 'Alice')
assert(extract('Dear Bob, your order #42 is ready.', 'Dear {{name}}, your order #{{order}} is ready.').name == 'Bob')
assert(extract('Dear Bob, your order #42 is ready.', 'Dear {{name}}, your order #{{order}} is ready.').order == '42')
assert(isNull(extract('no match here', 'From: {{name}} <{{email}}>').name))
assert(isNull(extract('no match here', 'From: {{name}} <{{email}}>').email))
assert(extract('price: $99 (USD)', 'price: ${{amount}} (USD)').amount == '99')
assert(extract('Name: John\nEmail: john@acme.com', 'Name: {{name}}\nEmail: {{email}}').name == 'John')
assert(extract('Name: John\nEmail: john@acme.com', 'Name: {{name}}\nEmail: {{email}}').email == 'john@acme.com')
assert(extract('Subject: Hello\nFrom: Alice\nTo: Bob', 'Subject: {{subject}}\nFrom: {{from}}\nTo: {{to}}').subject == 'Hello')
assert(extract('Subject: Hello\nFrom: Alice\nTo: Bob', 'Subject: {{subject}}\nFrom: {{from}}\nTo: {{to}}').from == 'Alice')
assert(extract('Subject: Hello\nFrom: Alice\nTo: Bob', 'Subject: {{subject}}\nFrom: {{from}}\nTo: {{to}}').to == 'Bob')
