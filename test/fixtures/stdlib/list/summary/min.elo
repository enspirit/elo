assert(min([3, 1, 4, 1, 5]) == 1)
assert(min([42]) == 42)
assert(min([-3, -1, -4]) == -4)
assert(isNull(min([])))

# min on datetime arrays preserves type (regression test)
assert(typeOf(min([SOD, SOD - P1D])) == 'DateTime')
assert(min([SOD, SOD - P1D]) == SOD - P1D)

# Two-argument form: clamping one value against one bound should not build a
# list to look at two numbers.
assert(min(3, 7) == 3)
assert(min(7, 3) == 3)
assert(min(-5, 2) == -5)
assert(min(4, 4) == 4)
assert(min(2.5, 1.5) == 1.5)
assert(min(1, 2.5) == 1)
# Two values that are not numbers compare rather than coerce: Math.min would
# answer NaN, which serialises to null — a wrong value where a refusal or a
# comparison was expected.
assert(min('a', 'b') == 'a')
assert(min('b', 'a') == 'a')
