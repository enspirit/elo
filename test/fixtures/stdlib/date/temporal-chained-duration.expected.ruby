->(_) { def k_now(tz); Time.now.in_time_zone(ActiveSupport::TimeZone[tz]).to_datetime.change(offset: 0) end; def k_today(tz); k_now(tz).to_date end; (raise "Assertion failed" unless (->(v) { case v when NilClass; 'Null' when ActiveSupport::Duration; 'Duration' when Date, DateTime, Time; 'DateTime' when Integer; 'Int' when Float; 'Float' when TrueClass, FalseClass; 'Bool' when String; 'String' when Proc; 'Function' when Array; 'List' else 'Tuple' end }).call(k_today("UTC") + ActiveSupport::Duration.parse("P1M") + ActiveSupport::Duration.parse("PT12H")) == "DateTime"; true) }.call(nil);
