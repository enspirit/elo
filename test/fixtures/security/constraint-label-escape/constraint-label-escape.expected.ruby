->(_) { def p_fail(p, m = nil, c = nil) { success: false, path: p, message: m || '', value: nil, cause: c || [] } end; def p_int(v, p); return p_ok(v, p) if v.is_a?(Integer); return p_ok(Integer(v, 10), p) if v.is_a?(String) rescue nil; p_fail(p, "expected Int, got #{v.nil? ? 'Null' : v.is_a?(String) ? v.inspect : v.class}") end; def p_ok(v, p) { success: true, path: p, message: '', value: v, cause: [] } end; def p_unwrap(r); return r[:value] if r[:success]; find_error = ->(e) {; return e if e[:message] && !e[:message].empty?; return find_error.call(e[:cause][0]) if e[:cause] && e[:cause][0]; e; }; err = find_error.call(r); raise "#{err[:path] || '.'}: #{err[:message] || 'type error'}" end; (raise "Assertion failed" unless (_p_T = ->(v, p) { _r = (method(:p_int)).call(v, p); return _r unless _r[:success]; i = _r[:value]; return p_fail(p, "constraint 'bad\\' failed") unless (i > 0); _r }; T = ->(v) { p_unwrap(_p_T.call(v, '')) }; T.call(5)) == 5; true) }.call(nil);
->(_) { def p_fail(p, m = nil, c = nil) { success: false, path: p, message: m || '', value: nil, cause: c || [] } end; def p_int(v, p); return p_ok(v, p) if v.is_a?(Integer); return p_ok(Integer(v, 10), p) if v.is_a?(String) rescue nil; p_fail(p, "expected Int, got #{v.nil? ? 'Null' : v.is_a?(String) ? v.inspect : v.class}") end; def p_ok(v, p) { success: true, path: p, message: '', value: v, cause: [] } end; def p_unwrap(r); return r[:value] if r[:success]; find_error = ->(e) {; return e if e[:message] && !e[:message].empty?; return find_error.call(e[:cause][0]) if e[:cause] && e[:cause][0]; e; }; err = find_error.call(r); raise "#{err[:path] || '.'}: #{err[:message] || 'type error'}" end; (raise "Assertion failed" unless (_p_T = ->(v, p) { _r = (method(:p_int)).call(v, p); return _r unless _r[:success]; i = _r[:value]; return p_fail(p, "constraint 'weird'quote' failed") unless (i > 0); _r }; T = ->(v) { p_unwrap(_p_T.call(v, '')) }; T.call(5)) == 5; true) }.call(nil);
