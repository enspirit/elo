assert(length('#{1+1}') == 6)
assert('#{1+1}' == '#' + '{1+1}')
assert('#{`id`}' == '#' + '{`id`}')
assert(length('#@x') == 3)
assert('#@x' == '#' + '@x')
assert(length('#@@x') == 4)
assert('#@@x' == '#' + '@@x')
assert(length('#$x') == 3)
assert('#$x' == '#' + '$x')
assert('a#b' == 'a' + '#' + 'b')
